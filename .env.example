# Sanity — create a free project at https://sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity write token — needed for CSV import API route
# Get from sanity.io → project → API → Tokens → Add token (Editor role)
SANITY_API_TOKEN=your_write_token_here

# Behold Instagram widget — https://behold.so (free tier: 1 feed, 12 posts)
# Connect your Instagram account, create a feed, copy the Feed ID
NEXT_PUBLIC_BEHOLD_FEED_ID=your_behold_feed_id_here

# Resend — for contact form emails https://resend.com (free tier: 3k emails/month)
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL=Info@alleghenydems.com
