# Sanity — create a free project at https://sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity write token — needed for CSV import API route
# Get from sanity.io → project → API → Tokens → Add token (Editor role)
SANITY_API_TOKEN=your_write_token_here

# Behold Instagram widget — https://behold.so (free tier: 1 feed, 12 posts)
# Connect your Instagram account, create a feed, copy the Feed ID
NEXT_PUBLIC_BEHOLD_FEED_ID=your_behold_feed_id_here

# Facebook Graph API — for realtime homepage post feed
# Use a long-lived Page access token with pages_read_engagement
FACEBOOK_PAGE_ID=your_page_id_or_username_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here
# Optional; defaults to v23.0
FACEBOOK_GRAPH_API_VERSION=v23.0

# Resend — for contact form emails https://resend.com (free tier: 3k emails/month)
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL=Info@alleghenydems.com

# Members-only area (magic-link auth)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_32_plus_byte_random_secret_here
# From address for sign-in link emails (domain must be verified in Resend)
MEMBERS_AREA_FROM_EMAIL="Allegheny Dems Members <noreply@alleghenydems.com>"

# WordPress hybrid nav — set to false to show the native nav
NEXT_PUBLIC_WP_NAV=false
